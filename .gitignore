.DS_Store
.env
/node_modules/

# Build output (Vite client bundle; the Cloudflare plugin writes its own)
/dist/
/.cloudflare/

# Local dev secret for the Worker (`cf deploy --secrets-file .dev.vars`)
/.dev.vars

# React Router (retired with the shell cutover; entries kept until history says otherwise)
/.react-router/
/build/

# Vendored agent-skill assets and the installer's lockfile: local tooling, never
# shipped, and already excluded from lint (see oxlint.config.ts). The vendored
# react-router skill under .agents/ is tracked on purpose and stays tracked.
/agent/
/.agents/
/.claude/
/.opencode/
/skills-lock.json

# Local Worker runtime state (cf dev / miniflare)
/.wrangler/
